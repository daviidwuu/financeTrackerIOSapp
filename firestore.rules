rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Validation: Transactions
    function isValidTransaction(data) {
      return data.title is string && data.title.size() > 0
          && data.amount is number
          && data.date is timestamp
          && data.type in ['income', 'expense'];
    }
    
    // Validation: Groups
    function isValidGroup(data) {
      return data.name is string && data.name.size() > 0
          && data.members is list
          && data.createdBy is string;
    }
    
    // Validation: Split Requests
    function isValidSplitRequest(data) {
        return data.amount is number && data.amount > 0
            && data.fromUid is string
            && data.toUid is string;
    }

    // ✅ NEW: Root collection for groups (Wiki-style shared)
    match /groups/{groupId} {
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members.hasAll([request.auth.uid])
                    && isValidGroup(request.resource.data);
      
      allow read: if request.auth.uid in resource.data.members;
      
      // Any member can update (wiki-style)
      allow update: if request.auth.uid in resource.data.members
                    && isValidGroup(request.resource.data);
      
      // Any member can delete (wiki-style)
      // Any member can delete (wiki-style)
      allow delete: if request.auth.uid in resource.data.members;

      // ✅ NEW: Group Transactions Subcollection
      match /transactions/{transactionId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
      
      // ✅ NEW: Archived Group Transactions
      match /archived_transactions/{transactionId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }
    
    match /split_requests/{requestId} {
      allow create: if request.auth.uid == request.resource.data.fromUid
                    && (request.resource.data.status == 'pending' 
                        || request.resource.data.status == 'paid'
                        || request.resource.data.status in ['blocked_by_group', 'blocked_by_friendship'])
                    && isValidSplitRequest(request.resource.data);
      
      allow read: if request.auth.uid == resource.data.fromUid 
                  || request.auth.uid == resource.data.toUid
                  || (resource.data.groupId != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members);
      
      // Allow receiver to update (accept/decline) OR sender to update (cancel/delete/mark paid)
      allow update: if request.auth.uid == resource.data.toUid 
                    || request.auth.uid == resource.data.fromUid;
                    
      // ✅ Allow sender OR receiver to delete
      allow delete: if request.auth.uid == resource.data.fromUid 
                    || request.auth.uid == resource.data.toUid;
    }
    
    // ✅ NEW: Root collection for friend requests
    match /friend_requests/{requestId} {
      allow create: if request.auth.uid == request.resource.data.fromUid;
      allow read: if request.auth.uid == resource.data.fromUid 
                  || request.auth.uid == resource.data.toUid;
      allow update: if request.auth.uid == resource.data.toUid;
      allow delete: if request.auth.uid == resource.data.fromUid
                    || request.auth.uid == resource.data.toUid;
    }

    // ✅ NEW: Archived Split Requests
    match /archived_split_requests/{requestId} {
      allow create: if request.auth.uid == request.resource.data.fromUid 
                    || request.auth.uid == request.resource.data.toUid;
      allow read: if request.auth.uid == resource.data.fromUid 
                  || request.auth.uid == resource.data.toUid;
    }
    
    // ✅ NEW: Root collection for group invitations
    match /group_invitations/{inviteId} {
      allow create: if request.auth.uid == request.resource.data.fromUid;
      allow read: if request.auth.uid == resource.data.fromUid 
                  || request.auth.uid == resource.data.toUid;
      allow update: if request.auth.uid == resource.data.toUid;
      allow delete: if request.auth.uid == resource.data.fromUid
                    || request.auth.uid == resource.data.toUid;
    }

    match /users {
      // 1. Username Availability Check (Collection-level)
      allow list: if request.auth != null 
                  && request.query.limit <= 1 
                  && request.query.filters.size() == 1 
                  && request.query.filters[0].field == "username";
      
      match /{userId} {
        // 2. Profile Access
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
        
        // 3. Subcollections
        match /transactions/{document=**} { 
          allow read, write: if request.auth.uid == userId;
          // Note: We don't enforce isValidTransaction() strictly here yet for backward compatibility 
          // with existing user data that might miss fields, but generally recommended.
        }
        match /budgets/{document=**} { 
          allow read, write: if request.auth.uid == userId; 
        }
        match /savingGoals/{document=**} { 
          allow read, write: if request.auth.uid == userId; 
        }
        match /recurringTransactions/{document=**} { 
          allow read, write: if request.auth.uid == userId; 
        }
        match /categories/{document=**} { 
          allow read, write: if request.auth.uid == userId; 
        }
        
        // ✅ NEW: Private guest subcollection
        match /guests/{guestId} {
          allow read, write: if request.auth.uid == userId;
        }
        
        // ✅ NEW: Archived Transactions
        match /archived_transactions/{document=**} {
          allow read, write: if request.auth.uid == userId;
        }
        
        // LEGACY: Keep for 30 days (read-only)
        match /groups/{groupId} {
          allow read: if request.auth.uid == userId;
          allow write: if false;  // ⬅️ No new writes
        }
        
        match /requests/{requestId} {
          allow read: if request.auth.uid == userId;
          allow write: if false;  // ⬅️ No new writes
        }
        
        // 4. Friends (Mutual Add Exception) - Still needed for active friends list
        match /friends/{friendId} {
          allow read: if request.auth.uid == userId; 
          allow write: if request.auth.uid == userId || request.auth.uid == friendId;
        }
      }
    }
  }
}
